#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define NAVIGATION 1
#define NUMERIC 2
#define FUNCTIONS 3
#define SETTINGS 4

/ {
    chosen {
    };

     conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <FUNCTIONS NAVIGATION>;
            then-layer = <SETTINGS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            display-name = "default";
            bindings = <
&kp ESC           &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                                       &kp N6    &kp N7    &kp N8      &kp N9   &kp N0     &kp BSPC
&kp TAB           &kp Q  &kp W    &kp E    &kp R     &kp T                                        &kp Y     &kp U     &kp I       &kp O    &kp P      &kp BSLH
&lt NUMERIC RET   &kp A  &kp S    &kp D    &kp F     &kp G                                        &kp H     &kp J     &kp K       &kp L    &kp SEMI   &kp SQT
&mt LSHIFT LPAR   &kp Z  &kp X    &kp C    &kp V     &kp B      &kp C_MUTE   &none                &kp N     &kp M     &kp COMMA   &kp DOT  &kp FSLH   &mt RSHIFT RPAR
             &none   &kp LCTRL   &mt LALT LBKT   &mt LGUI RBKT  &kp SPACE    &lt NAVIGATION RET  &mt RGUI MINUS  &lt FUNCTIONS EQUAL &kp RALT  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LC(LS(TAB)) LC(TAB)>;
        };

        navigation_layer {
            display-name = "navigation";
            bindings = <
&kp GRAVE       &trans       &trans       &trans       &trans       &trans                              &trans    &kp INS    &kp HOME   &kp PG_UP    &kp MINUS  &kp EQUAL
&studio_unlock  &trans       &trans       &trans       &trans       &trans                              &kp BSPC  &kp DEL    &kp END    &kp PG_DN    &kp LBKT   &kp RBKT
&trans          &kp F19      &kp F18      &kp F17      &kp F16      &kp LC(GRAVE)                       &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT    &trans     &kp SQT
&kp LSHIFT      &kp LA(F19)  &kp LA(F18)  &kp LA(F17)  &kp LA(F16)  &kp LG(TAB)  &kp C_PP       &trans  &trans    &trans     &trans       &trans    &trans     &trans
                         &trans       &trans       &kp LALT       &kp LGUI       &kp LA(SPACE)  &trans  &trans    &trans    &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_NEXT C_PREV &inc_dec_kp LC(LG(LEFT)) LC(LG(RIGHT))>;
        };

        numeric_layer {
            display-name = "numeric";
            bindings = <
&trans         &none        &none     &none       &none       &none                    &none       &none       &none       &none      &none      &trans
&none          &kp N1       &kp N2    &kp N3      &kp N4      &kp N5                   &kp N6      &kp N7      &kp N8      &kp N9     &kp N0     &none
&none          &kp EXCL     &kp AT    &kp HASH    &kp DLLR    &kp PRCNT                &kp CARET   &kp AMPS    &kp ASTRK   &kp LPAR   &kp RPAR   &none
&trans         &none        &none     &none       &none       &none   &trans  &trans   &none       &none       &none       &none      &none      &trans
                            &trans    &trans      &trans    &trans    &trans  &trans   &trans      &trans      &trans      &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp PG_UP PG_DN>;
         };

        functions_layer {
            display-name = "functions";
            bindings = <
&trans         &kp F13   &kp F14    &kp F15      &kp F16    &none                       &none       &none       &kp KP_DIVIDE  &kp KP_MULTIPLY   &kp KP_MINUS   &trans
&trans         &kp F9    &kp F10    &kp F11      &kp F12    &none                       &none       &kp KP_N7   &kp KP_N8      &kp KP_N9         &kp KP_PLUS    &trans
&trans         &kp F5    &kp F6     &kp F7       &kp F8     &kp PRCNT                   &kp KP_DOT  &kp KP_N4   &kp KP_N5      &kp KP_N6         &kp KP_PLUS    &trans
&trans         &kp F1    &kp F2     &kp F3       &kp F4     &kp RBRC   &trans  &trans   &kp KP_N0   &kp KP_N1   &kp KP_N2      &kp KP_N3         &kp KP_ENTER   &trans
                            &trans    &trans      &trans    &trans     &trans  &trans   &trans      &kp KP_N0   &kp KP_N0      &kp KP_DOT
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp PG_UP PG_DN>;
         };

        settings_layer {
            display-name = "settings";
            bindings = <
&bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                    &none  &none  &none  &none  &none  &none
&none             &none           &none           &none           &none           &none                           &none  &none  &none  &none  &none  &none
&none             &none           &none           &none           &none           &none                           &none  &none  &none  &none  &none  &none
&none             &none           &none           &none           &none           &none           &none   &none   &none  &none  &none  &none  &none  &none
                                  &none           &none           &none           &none           &none   &none   &none  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_NEXT C_PREV &inc_dec_kp PG_UP PG_DN>;
       };
    };
};
